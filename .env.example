# Chatio — variables de entorno
#
# Copiar como `.env` EN LA RAÍZ DEL REPOSITORIO (no dentro de backend/) y completar.
# `.env` está en .gitignore y nunca se versiona.
#
# Este archivo NO contiene valores reales: los de abajo son ejemplos o defaults
# de desarrollo. Los secretos de producción viven únicamente en el servidor.
#
# El esquema de entorno crece iteración por iteración (decisión D026): acá solo
# están las variables que el código YA lee y valida. Las de autenticación, email
# y Alexa se agregan cuando llega su iteración.

# ─── Aplicación ────────────────────────────────────────────────────────────────
# development | test | production
NODE_ENV=development
PORT=3000

# Nivel del logger: fatal | error | warn | info | debug | trace | silent
# En producción no se admiten `debug` ni `trace` (SECURITY.md §8).
LOG_LEVEL=debug

# true solamente si la app corre detrás de un reverse proxy (Nginx en el VPS).
# Necesario para que el rate limiting vea la IP real del cliente.
TRUST_PROXY=false

# ─── Base de datos ─────────────────────────────────────────────────────────────
# Debe empezar con mongodb:// o mongodb+srv://
MONGODB_URI=mongodb://127.0.0.1:27017/chatio_dev
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# ─── CORS ──────────────────────────────────────────────────────────────────────
# Lista separada por comas con los orígenes del panel web.
# Obligatoria y no vacía en producción. Nunca se usa `*`.
CORS_ORIGINS=http://localhost:5173

# ─── Límites ───────────────────────────────────────────────────────────────────
# Tamaño máximo del body JSON aceptado.
BODY_LIMIT=32kb

# Rate limit general de la API.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Rate limit de los healthchecks (`/health` y `/ready`), para que no sirvan
# como canal de sondeo (SECURITY.md §16).
HEALTH_RATE_LIMIT_WINDOW_MS=60000
HEALTH_RATE_LIMIT_MAX=60

# ─── Autenticación (Iteración 2) ───────────────────────────────────────────────
# Obligatorios, sin valor por defecto y distintos entre sí. Mínimo 32 caracteres.
# Generar uno nuevo por entorno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Vida del access token (D001: corto a propósito). En producción no puede pasar de 3600.
ACCESS_TOKEN_TTL_SECONDS=900
# Vida del refresh token y de la sesión que lo respalda.
REFRESH_TOKEN_TTL_SECONDS=604800

# Coste de bcrypt. En producción no puede ser menor que 12 (SECURITY.md §3).
BCRYPT_COST=12

# Rate limit de los endpoints sensibles (API.md §14).
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=5
REFRESH_RATE_LIMIT_WINDOW_MS=900000
REFRESH_RATE_LIMIT_MAX=30

# ─── Seed del primer administrador ─────────────────────────────────────────────
# Solo las lee `npm run seed:admin`, no la aplicación. No hace falta dejarlas en el
# `.env`: conviene pasarlas en la misma línea del comando y no guardarlas.
#   SEED_ADMIN_EMAIL=... SEED_ADMIN_FIRST_NAME=... SEED_ADMIN_LAST_NAME=...
#   npm run seed:admin -- --generate-password
#
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_FIRST_NAME=
# SEED_ADMIN_LAST_NAME=
# SEED_ADMIN_PASSWORD=      (omitir si se usa --generate-password)

# ─── Apagado ordenado ──────────────────────────────────────────────────────────
# Tiempo máximo de espera al cerrar antes de forzar la salida.
SHUTDOWN_TIMEOUT_MS=10000
