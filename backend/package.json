{
  "name": "chatio-backend",
  "version": "0.1.0",
  "private": true,
  "description": "API de Chatio: panel de familiares/cuidadores y endpoint de la skill de Alexa",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "seed:admin": "node scripts/seedAdmin.js"
  },
  "dependencies": {
    "bcrypt": "6.0.0",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dotenv": "16.6.1",
    "express": "4.22.3",
    "express-rate-limit": "7.5.1",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "luxon": "3.7.2",
    "mongoose": "8.24.4",
    "node-cron": "4.2.1",
    "pino": "9.14.0",
    "pino-http": "10.5.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@vitest/coverage-v8": "5.0.2",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "mongodb-memory-server": "10.4.3",
    "pino-pretty": "13.1.3",
    "prettier": "3.9.9",
    "supertest": "7.3.0",
    "vitest": "5.0.2"
  }
}
